# autoload -U +X bashcompinit && bashcompinit
# complete -o nospace -C /opt/homebrew/bin/boundary boundary

# Example: work MCP / tokens — never commit real secrets
# [[ -f ~/.token_prod ]] && export TOKEN_PROD=...
